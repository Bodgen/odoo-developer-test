<odoo>
    <data>
<!--      Список-->
        <record id="tcc_list" model="ir.ui.view">
            <field name="name">company.hr.military.tcc.list</field>
            <field name="model">company.hr.military.tcc</field>
            <field name="arch" type="xml">
                <list string="ТЦК та СП" duplicate="false">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="phone"/>
                </list>
            </field>
        </record>

<!--      Form-->
        <record id="tcc_form" model="ir.ui.view">
            <field name="name">company.hr.military.tcc.form</field>
            <field name="model">company.hr.military.tcc</field>
            <field name="arch" type="xml">
                <form string="ТЦК та СП">
                    <sheet>
                        <group>
                            <field name="name"
                                   placeholder="Наприклад: Шевченківський РТЦК та СП"/>

                            <field name="code"
                                   placeholder="Наприклад: TCC-001"/>

                            <field name="phone_invalid" invisible="1"/>

                            <label for="phone"/>

                            <div>
                                <field name="phone"
                                       placeholder="+380671234567"
                                       decoration-danger="phone_invalid"
                                       nolabel="1"/>

                                <div class="text-danger mt-1"
                                     invisible="not phone_invalid">
                                    Номер повинен мати формат
                                    +380XXXXXXXXX або 0XXXXXXXXX.
                                </div>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tcc_search" model="ir.ui.view">
            <field name="name">company.hr.military.tcc.search</field>
            <field name="model">company.hr.military.tcc</field>
            <field name="arch" type="xml">
                <search string="Пошук ТЦК та СП">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="phone"/>
                </search>
            </field>
        </record>

      <!--      Action-->
        <record id="action_tcc" model="ir.actions.act_window">
            <field name="name">ТЦК та СП</field>
            <field name="res_model">company.hr.military.tcc</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="tcc_search"/>
        </record>

        <menuitem
            id="menu_tcc"
            name="ТЦК та СП"
            parent="hr.menu_human_resources_configuration"
            action="action_tcc"
            sequence="50"
            groups="hr.group_hr_manager"
        />
    </data>
</odoo>